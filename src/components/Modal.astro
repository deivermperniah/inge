---
// Envoltorio común para <dialog>: cabecera con título y botón cerrar, cuerpo con scroll y pie opcional.
import { Cancel01Icon } from '@hugeicons/core-free-icons';
import Icon from './Icon.astro';
import { cn } from '../lib/utils';

interface Props {
	id: string;
	title?: string;
	size?: 'md' | 'lg' | 'xl';
	class?: string;
}

const { id, title, size = 'md', class: className } = Astro.props;

const sizeClass = {
	md: 'max-w-lg',
	lg: 'max-w-3xl',
	xl: 'max-w-4xl',
}[size];
---

<dialog id={id} class={cn(sizeClass, className)} aria-labelledby={title ? `${id}-title` : undefined}>
	<div class="flex items-center justify-between gap-4 border-b px-5 py-3.5">
		<div class="min-w-0">
			{title && (
				<h2 id={`${id}-title`} class="truncate text-base font-semibold tracking-tight">{title}</h2>
			)}
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<slot name="header-extra" />
			<form method="dialog">
				<button
					class="flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
					aria-label="Cerrar"
				>
					<Icon icon={Cancel01Icon} size={15} />
				</button>
			</form>
		</div>
	</div>

	<div class="max-h-[70vh] overflow-y-auto px-5 py-4">
		<slot />
	</div>

	{
		Astro.slots.has('footer') && (
			<div class="border-t bg-muted/30 px-5 py-3">
				<slot name="footer" />
			</div>
		)
	}
</dialog>
