---
import Modal from './Modal.astro';
import Icon from './Icon.astro';
import Switch from './Switch.astro';
import { BookOpen01Icon } from '@hugeicons/core-free-icons';

interface Props {
	subjects: { id: string; name: string }[];
	hidden: Set<string>;
}

const { subjects, hidden } = Astro.props;
---

<Modal id="subjects-modal" title="Mis asignaturas" size="lg">
	<p class="mb-4 text-sm text-muted-foreground">
		Oculta las asignaturas que no quieres ver en tu inicio.
	</p>

	{
		subjects.length === 0 ? (
			<p class="rounded-lg border border-dashed py-10 text-center text-sm text-muted-foreground">
				No hay asignaturas en el trayecto activo.
			</p>
		) : (
			<ul class="divide-y overflow-hidden rounded-lg border bg-card">
				{subjects.map((subject) => {
					const isHidden = hidden.has(subject.id);
					return (
						<li
							class="group/row flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/40"
							data-subject-id={subject.id}
							data-hidden={String(isHidden)}
						>
							<span class="shrink-0 text-muted-foreground transition-opacity group-data-[hidden=true]/row:opacity-50">
								<Icon icon={BookOpen01Icon} size={16} />
							</span>
							<span class="min-w-0 flex-1 truncate text-sm font-medium transition-colors group-data-[hidden=true]/row:text-muted-foreground group-data-[hidden=true]/row:line-through">
								{subject.name}
							</span>
							<Switch checked={!isHidden} label={`Mostrar ${subject.name}`} class="subject-switch" />
						</li>
					);
				})}
			</ul>
		)
	}
</Modal>

<script>
	document.addEventListener('open-subjects-modal', () => {
		const modal = document.getElementById('subjects-modal') as HTMLDialogElement;
		modal?.showModal();
	});

	document.querySelectorAll<HTMLButtonElement>('.subject-switch').forEach((sw) => {
		const row = sw.closest<HTMLElement>('[data-subject-id]')!;

		sw.addEventListener('click', async () => {
			const wasHidden = row.dataset.hidden === 'true';
			const nowHidden = !wasHidden;

			row.dataset.hidden = String(nowHidden);
			sw.setAttribute('aria-checked', String(!nowHidden));
			sw.disabled = true;
			sw.setAttribute('aria-busy', 'true');

			try {
				const res = await fetch('/api/subjects/personal-toggle', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ subject_id: row.dataset.subjectId, hidden: nowHidden }),
				});
				if (!res.ok) throw new Error(String(res.status));
			} catch {
				row.dataset.hidden = String(wasHidden);
				sw.setAttribute('aria-checked', String(!wasHidden));
			} finally {
				sw.disabled = false;
				sw.removeAttribute('aria-busy');
			}
		});
	});
</script>
