---
interface Props {
	userEmail: string;
	trayectoYear?: number;
	totalSubjects: number;
	totalTasks: number;
	doneTasks: number;
	isAdmin: boolean;
}

const { userEmail, trayectoYear, totalSubjects, totalTasks, doneTasks, isAdmin } =
	Astro.props;

const pendingTasks = totalTasks - doneTasks;
const pct = totalTasks > 0 ? Math.round((doneTasks / totalTasks) * 100) : 0;
---

<header
	class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 shadow-sm backdrop-blur-md"
	data-total-tasks={totalTasks}
	data-done-tasks={doneTasks}
>
	<div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between gap-4 px-6">
		<div class="flex items-center gap-6">
			<a href="/" class="text-xl font-bold tracking-tight">inge</a>

			<div class="hidden items-center gap-3 sm:flex">
				<span class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">
					<strong>{totalSubjects}</strong> asignaturas
				</span>

				<div class="group relative">
					<span
						class="cursor-help rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700"
					>
						<strong>{totalTasks}</strong> tareas
					</span>
					<div
						class="invisible absolute left-1/2 top-full z-50 mt-2 min-w-40 -translate-x-1/2 rounded-lg border border-gray-200 bg-white p-3 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100"
					>
						<div class="flex justify-between gap-4 text-sm">
							<span class="text-gray-500">✅ Realizadas:</span>
							<strong id="hdr-done">{doneTasks}</strong>
						</div>
						<div class="mt-1 flex justify-between gap-4 text-sm">
							<span class="text-gray-500">⏳ Faltantes:</span>
							<strong id="hdr-pending">{pendingTasks}</strong>
						</div>
					</div>
				</div>

				{trayectoYear && (
					<span class="text-sm text-gray-500">Trayecto {trayectoYear}</span>
				)}
			</div>
		</div>

		<div class="relative">
			<button
				id="settings-btn"
				class="flex items-center gap-1 rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-100"
				title="Configuración"
			>
				⚙
			</button>

			<div
				id="settings-menu"
				hidden
				class="absolute right-0 top-full z-50 mt-2 w-64 rounded-lg border border-gray-200 bg-white p-4 shadow-lg"
			>
				<div class="mb-4">
					<span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
						Cuenta
					</span>
					<p class="mt-1 truncate text-sm text-gray-700">{userEmail}</p>
				</div>

				<div class="mb-4">
					<span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
						Tema
					</span>
					<select
						id="theme-select"
						class="mt-1 w-full rounded border border-gray-300 px-2 py-1.5 text-sm"
					>
						<option value="system">Sistema</option>
						<option value="dark">Oscuro</option>
						<option value="light">Claro</option>
					</select>
				</div>

				{
					isAdmin && (
						<div class="mb-4">
							<span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
								Asignaturas
							</span>
							<a
								href="/admin/asignaturas"
								class="mt-1 block rounded border border-gray-300 px-3 py-1.5 text-center text-sm hover:bg-gray-50"
							>
								Visibilidad
							</a>
						</div>
					)
				}

				<a
					href="/logout"
					class="block rounded border border-gray-300 px-3 py-1.5 text-center text-sm text-red-600 hover:bg-red-50"
				>
					Cerrar sesión
				</a>
			</div>
		</div>
	</div>

	<div class="h-1 bg-gray-200">
		<div
			id="hdr-prog"
			class="h-full bg-blue-600 transition-all duration-300"
			style={`width: ${pct}%`}
		/>
	</div>
</header>

<script>
	const btn = document.getElementById('settings-btn')!;
	const menu = document.getElementById('settings-menu')!;

	btn.addEventListener('click', (e) => {
		e.stopPropagation();
		menu.hidden = !menu.hidden;
	});

	document.addEventListener('click', (e) => {
		if (!menu.hidden && !menu.contains(e.target as Node)) {
			menu.hidden = true;
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') menu.hidden = true;
	});
</script>