---
import HeaderActions from './header/HeaderActions';

interface Props {
	userEmail: string;
	totalTasks: number;
	doneTasks: number;
	isAdmin: boolean;
}

const { userEmail, totalTasks, doneTasks, isAdmin } = Astro.props;

const pct = totalTasks > 0 ? Math.round((doneTasks / totalTasks) * 100) : 0;
---

<header
	class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur-xl supports-backdrop-filter:bg-background/70"
	data-total-tasks={totalTasks}
	data-done-tasks={doneTasks}
>
	<div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<a
			href="/"
			class="flex items-center gap-2.5 rounded-xl outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
		>
			<img src="/logo.png" alt="" class="size-8 rounded-lg bg-white p-1 ring-1 ring-border" />
			<span class="text-lg font-semibold tracking-tight">inge</span>
		</a>

		<HeaderActions client:load userEmail={userEmail} isAdmin={isAdmin} />
	</div>

	{
		totalTasks > 0 && (
			<div class="absolute inset-x-0 -bottom-px h-0.5" aria-hidden="true">
				<div
					id="hdr-prog"
					class="h-full bg-linear-to-r from-primary/70 to-primary transition-[width] duration-500 ease-out"
					style={`width: ${pct}%`}
				/>
			</div>
		)
	}
</header>
