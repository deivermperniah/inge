---
import Modal from './Modal.astro';
import { SCHEDULE } from '../data/schedule';

interface Props {
	subjects: {
		id: string;
		name: string;
		tasks: { id: string; trimestre: number }[];
	}[];
	done: Set<string>;
}

const { subjects, done } = Astro.props;

// Estado de una asignatura en un trimestre: none | pending | progress | complete
function trimState(
	subj: { name: string; tasks: { id: string; trimestre: number }[] },
	t: number,
) {
	const ofTrim = subj.tasks.filter((task) => task.trimestre === t);
	if (ofTrim.length === 0) return 'none';
	const doneCount = ofTrim.filter((task) => done.has(task.id)).length;
	if (doneCount === 0) return 'pending';
	if (doneCount === ofTrim.length) return 'complete';
	return 'progress';
}

const stateClass = {
	none: '',
	pending: 'bg-danger/15',
	progress: 'bg-warning/15',
	complete: 'bg-success/15',
} as const;

// Expande cada celda en su cantidad de columnas para mantener 3 columnas parejas
const expandedCells = (row: (typeof SCHEDULE)[number]) =>
	row.cells.flatMap((cell) =>
		Array.from({ length: cell.span ?? 1 }, () => cell.text),
	).slice(0, 3);
---

<Modal id="schedule-modal" title="Trayecto III 2026" size="xl">
	<div class="overflow-x-auto">
		<table class="w-full table-fixed border-collapse text-sm">
			<thead>
				<tr class="border-b border-border">
					<th
						class="w-[40%] border-r border-border px-3 py-2 text-left text-xs font-medium text-muted-foreground"
					>
						Unidad curricular
					</th>
					{[1, 2, 3].map((t) => (
						<th
							class="border-r border-border px-3 py-2 text-center text-xs font-medium text-muted-foreground last:border-r-0"
						>
							Trimestre {t}
						</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					SCHEDULE.map((row) => {
						const subj = subjects?.find((s) => s.name === row.subject);
						return (
							<tr class="border-b border-border last:border-b-0">
								<td class="border-r border-border px-3 py-2 text-sm font-medium">
									{row.subject}
								</td>
								{expandedCells(row).map((text, idx) => {
									const state = subj ? trimState(subj, idx + 1) : 'none';
									return (
										<td
											class="schedule-cell h-9 border-r border-border px-3 py-2 last:border-r-0"
											class:list={[stateClass[state]]}
											title={text || undefined}
											data-subject={subj?.id ?? ''}
											data-trim={idx + 1}
										/>
									);
								})}
							</tr>
						);
					})
				}
			</tbody>
		</table>
	</div>
</Modal>

<script>
	document.addEventListener('open-schedule-modal', () => {
		const modal = document.getElementById('schedule-modal') as HTMLDialogElement;
		modal?.showModal();
	});
</script>
