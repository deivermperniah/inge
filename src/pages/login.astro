---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import { Loading03Icon, ViewIcon, ViewOffSlashIcon } from '@hugeicons/core-free-icons';
import { createClient } from '../lib/supabase';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';

const supabase = createClient(Astro.cookies, Astro.request);
const {
	data: { user },
} = await supabase.auth.getUser();

if (user) {
	return Astro.redirect('/');
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = formData.get('email')?.toString() ?? '';
	const password = formData.get('password')?.toString() ?? '';

	if (!email || !password) {
		error = 'Completa todos los campos.';
	} else {
		const { error: authError } = await supabase.auth.signInWithPassword({
			email,
			password,
		});

		if (authError) {
			error = authError.message;
		} else {
			return Astro.redirect('/');
		}
	}
}
---

<AppLayout title="Iniciar sesión">
	<main class="flex min-h-screen items-center justify-center px-6 py-12">
		<div class="w-full max-w-sm">
			<div class="mb-8 flex flex-col items-center gap-3 text-center">
				<img src="/logo.png" alt="inge" class="size-12" />
				<h1 class="text-2xl font-semibold tracking-tight">Iniciar sesión</h1>
				<p class="text-sm text-muted-foreground">Accede para ver tus asignaturas y tareas.</p>
			</div>

			<form method="POST" class="flex flex-col gap-5">
				{error && (
					<p class="rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
						{error}
					</p>
				)}

				<div class="flex flex-col gap-2">
					<Label for="email">Correo electrónico</Label>
					<Input id="email" name="email" type="email" placeholder="tu@correo.com" required />
				</div>

				<div class="flex flex-col gap-2">
					<Label for="password">Contraseña</Label>
					<div class="relative">
						<Input id="password" name="password" type="password" placeholder="••••••••" className="pr-10" required />
						<button
							type="button"
							data-password-toggle
							aria-controls="password"
							aria-label="Mostrar contraseña"
							class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted-foreground transition-colors hover:text-foreground"
						>
							<Icon icon={ViewIcon} size={16} data-eye />
							<Icon icon={ViewOffSlashIcon} size={16} class="hidden" data-eye-off />
						</button>
					</div>
				</div>

				<Button type="submit" className="w-full" data-submit>
					<span class="hidden" data-spinner>
						<Icon icon={Loading03Icon} size={16} class="animate-spin" />
					</span>
					Entrar
				</Button>

				<p class="text-center text-sm text-muted-foreground">
					¿No tienes cuenta?{' '}
					<a href="/register" class="font-medium text-primary underline-offset-4 hover:underline">
						Regístrate
					</a>
				</p>
			</form>
		</div>
	</main>
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
				const input = document.getElementById(toggle.getAttribute('aria-controls') || '');
				const eye = toggle.querySelector('[data-eye]');
				const eyeOff = toggle.querySelector('[data-eye-off]');
				if (!input || !eye || !eyeOff) return;

				toggle.addEventListener('click', () => {
					const isVisible = input.type === 'text';
					input.type = isVisible ? 'password' : 'text';
					toggle.setAttribute('aria-label', isVisible ? 'Mostrar contraseña' : 'Ocultar contraseña');
					eye.classList.toggle('hidden', !isVisible);
					eyeOff.classList.toggle('hidden', isVisible);
				});
			});

			document.querySelectorAll('form').forEach((form) => {
				form.addEventListener('submit', () => {
					const btn = form.querySelector('[data-submit]');
					if (!(btn instanceof HTMLButtonElement)) return;
					btn.disabled = true;
					btn.setAttribute('aria-busy', 'true');
					btn.querySelector('[data-spinner]')?.classList.remove('hidden');
				});
			});
		});
	</script>
</AppLayout>
