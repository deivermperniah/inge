---
import '../styles/global.css';
import { createClient } from '../lib/supabase';

let error: string | null = null;
let success = false;

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = formData.get('email')?.toString() ?? '';
	const password = formData.get('password')?.toString() ?? '';

	if (!email || !password) {
		error = 'Completa todos los campos.';
	} else {
		const supabase = createClient(Astro.cookies);
		const { data, error: authError } = await supabase.auth.signUp({
			email,
			password,
		});

		if (authError) {
			error = authError.message;
		} else if (data.session) {
			return Astro.redirect('/');
		} else {
			success = true;
		}
	}
}
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>Registro</title>
	</head>
	<body class="flex min-h-screen items-center justify-center bg-gray-100">
		<main class="w-full max-w-sm rounded-lg bg-white p-8 shadow-md">
			<h1 class="mb-6 text-center text-2xl font-bold">Crear cuenta</h1>

			{
				success ? (
					<p class="rounded bg-green-100 p-3 text-sm text-green-800">
						Revisa tu correo para confirmar tu cuenta.
					</p>
				) : (
					<form method="POST" class="flex flex-col gap-4">
						{error && (
							<p class="rounded bg-red-100 p-3 text-sm text-red-800">{error}</p>
						)}

						<div class="flex flex-col gap-1">
							<label for="email" class="text-sm font-medium">
								Correo
							</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								class="rounded border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
							/>
						</div>

						<div class="flex flex-col gap-1">
							<label for="password" class="text-sm font-medium">
								Contraseña
							</label>
							<input
								id="password"
								name="password"
								type="password"
								required
								minlength={6}
								class="rounded border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
							/>
						</div>

						<button
							type="submit"
							class="mt-2 rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700"
						>
							Registrarse
						</button>
					</form>
				)
			}
		</main>
	</body>
</html>