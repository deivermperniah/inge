---
import '../styles/global.css';
import { createClient } from '../lib/supabase';

const supabase = createClient(Astro.cookies, Astro.request);
const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect('/login');
}

// Marcar / desmarcar tarea
if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const taskId = formData.get('task_id')?.toString();
	const done = formData.get('done') === 'true';

	if (taskId) {
		await supabase
			.from('task_progress')
			.upsert(
				{ user_id: user.id, task_id: taskId, done, updated_at: new Date().toISOString() },
				{ onConflict: 'user_id,task_id' },
			);
	}
	return Astro.redirect(Astro.url.pathname + Astro.url.search);
}

const { data: trayecto } = await supabase
	.from('trayectos')
	.select('id, year')
	.eq('active', true)
	.single();

const { data: subjects } = await supabase
	.from('subjects')
	.select('id, name, tasks(id, text, trimestre)')
	.eq('trayecto_id', trayecto?.id)
	.eq('hidden', false)
	.order('name');

const { data: progress } = await supabase
	.from('task_progress')
	.select('task_id, done')
	.eq('user_id', user.id);

const doneSet = new Set(progress?.filter((p) => p.done).map((p) => p.task_id));

// Estado por trimestre: none | pending | complete
function trimStatus(tasks: { id: string; trimestre: number }[], t: number) {
	const ofTrim = tasks.filter((task) => task.trimestre === t);
	if (ofTrim.length === 0) return 'none';
	const allDone = ofTrim.every((task) => doneSet.has(task.id));
	return allDone ? 'complete' : 'pending';
}
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>Inicio</title>
	</head>
	<body class="min-h-screen bg-gray-100">
		<header class="flex items-center justify-between bg-white px-6 py-4 shadow-sm">
			<h1 class="text-xl font-bold">Trayecto {trayecto?.year}</h1>
			<div class="flex items-center gap-4">
				<span class="text-sm text-gray-600">{user.email}</span>
				<a
					href="/logout"
					class="rounded bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700"
				>
					Salir
				</a>
			</div>
		</header>

		<main class="mx-auto max-w-4xl p-6">
			<div class="grid gap-4 sm:grid-cols-2">
				{
					subjects?.map((subject) => {
						const total = subject.tasks.length;
						const done = subject.tasks.filter((t) => doneSet.has(t.id)).length;

						return (
							<button
								data-subject={subject.id}
								class="open-modal flex flex-col gap-3 rounded-lg bg-white p-5 text-left shadow-sm transition hover:shadow-md"
							>
								<div class="flex items-start justify-between gap-2">
									<h2 class="font-semibold">{subject.name}</h2>
									<span class="text-gray-400" aria-hidden="true">
										›
									</span>
								</div>

								<div class="flex items-center justify-between">
									<span class="text-sm text-gray-500">
										{done}/{total}
									</span>
									<div class="flex gap-1.5">
										{[1, 2, 3].map((t) => {
											const status = trimStatus(subject.tasks, t);
											return (
												<span
													title={`Trimestre ${t}`}
													class:list={[
														'h-2.5 w-2.5 rounded-full',
														status === 'none' && 'bg-gray-200',
														status === 'pending' && 'bg-amber-400',
														status === 'complete' && 'bg-green-500',
													]}
												/>
											);
										})}
									</div>
								</div>
							</button>
						);
					})
				}
			</div>
		</main>

		{
			subjects?.map((subject) => (
				<dialog
					id={`modal-${subject.id}`}
					class="m-auto w-full max-w-lg rounded-lg p-0 backdrop:bg-black/50"
				>
					<div class="flex items-center justify-between border-b px-6 py-4">
						<div class="flex items-center gap-3">
							<h3 class="font-semibold">{subject.name}</h3>
							<div class="flex gap-1.5">
								{[1, 2, 3].map((t) => {
									const status = trimStatus(subject.tasks, t);
									return (
										<span
											title={`Trimestre ${t}`}
											class:list={[
												'h-2.5 w-2.5 rounded-full',
												status === 'none' && 'bg-gray-200',
												status === 'pending' && 'bg-amber-400',
												status === 'complete' && 'bg-green-500',
											]}
										/>
									);
								})}
							</div>
						</div>
						<form method="dialog">
							<button
								class="rounded p-1 text-gray-500 hover:bg-gray-100"
								aria-label="Cerrar"
							>
								✕
							</button>
						</form>
					</div>

					<div class="max-h-96 overflow-y-auto px-6 py-4">
						{subject.tasks.length === 0 ? (
							<p class="py-4 text-center text-sm text-gray-500">
								Ninguna tarea aún
							</p>
						) : (
							[1, 2, 3].map((t) => {
								const tasks = subject.tasks.filter((task) => task.trimestre === t);
								if (tasks.length === 0) return null;

								return (
									<div class="mb-4 last:mb-0">
										<h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
											Trimestre {t}
										</h4>
										<ul class="flex flex-col gap-2">
											{tasks.map((task) => {
												const done = doneSet.has(task.id);
												return (
													<li>
														<form method="POST" class="flex items-center gap-3">
															<input type="hidden" name="task_id" value={task.id} />
															<input
																type="hidden"
																name="done"
																value={done ? 'false' : 'true'}
															/>
															<button
																type="submit"
																class:list={[
																	'h-5 w-5 shrink-0 rounded-full border-2',
																	done
																		? 'border-green-600 bg-green-600'
																		: 'border-gray-300 bg-white hover:border-gray-400',
																]}
																aria-label={done ? 'Desmarcar' : 'Marcar'}
															/>
															<span
																class:list={[
																	'text-sm',
																	done && 'text-gray-400 line-through',
																]}
															>
																{task.text}
															</span>
														</form>
													</li>
												);
											})}
										</ul>
									</div>
								);
							})
						)}
					</div>
				</dialog>
			))
		}

		<script>
			document.querySelectorAll<HTMLButtonElement>('.open-modal').forEach((btn) => {
				btn.addEventListener('click', () => {
					const id = btn.dataset.subject;
					const modal = document.getElementById(`modal-${id}`) as HTMLDialogElement;
					modal?.showModal();
				});
			});
		</script>
	</body>
</html>