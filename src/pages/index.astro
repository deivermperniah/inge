---
import AppLayout from '../layouts/AppLayout.astro';
import { createClient } from '../lib/supabase';
import Header from '../components/Header.astro';
import Modal from '../components/Modal.astro';
import SubjectsModal from '../components/SubjectsModal.astro';
import ScheduleModal from '../components/ScheduleModal.astro';
import AdminSubjectsModal from '../components/admin/AdminSubjectsModal.astro';
import AdminManageModal from '../components/admin/AdminManageModal.astro';

const supabase = createClient(Astro.cookies, Astro.request);
const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect('/login');
}

const { data: trayecto } = await supabase
	.from('trayectos')
	.select('id, year, name')
	.eq('active', true)
	.single();

const { data: subjects } = await supabase
	.from('subjects')
	.select('id, name, tasks(id, text, trimestre)')
	.eq('trayecto_id', trayecto?.id)
	.eq('hidden', false)
	.order('name');

const { data: hidden } = await supabase
	.from('hidden_subjects')
	.select('subject_id')
	.eq('user_id', user.id);

const hiddenSet = new Set(hidden?.map((h) => h.subject_id));
const visibleSubjects = subjects?.filter((s) => !hiddenSet.has(s.id));

const { data: progress } = await supabase
	.from('task_progress')
	.select('task_id, done')
	.eq('user_id', user.id);

const doneSet = new Set(progress?.filter((p) => p.done).map((p) => p.task_id));

const { data: profile } = await supabase
	.from('profiles')
	.select('role')
	.eq('id', user.id)
	.single();

const isAdmin = profile?.role === 'admin';

// Solo para admins: todas las asignaturas del trayecto, incluidas las ocultas
const { data: adminSubjects } = isAdmin
	? await supabase
			.from('subjects')
			.select('id, name, hidden, tasks(id, text, trimestre)')
			.eq('trayecto_id', trayecto?.id)
			.order('name')
	: { data: null };

// Estado por trimestre: none | pending | progress | complete
function trimStatus(tasks: { id: string; trimestre: number }[], t: number) {
	const ofTrim = tasks.filter((task) => task.trimestre === t);
	if (ofTrim.length === 0) return 'none';
	const doneCount = ofTrim.filter((task) => doneSet.has(task.id)).length;
	if (doneCount === 0) return 'pending';
	if (doneCount === ofTrim.length) return 'complete';
	return 'progress';
}

const statusClass = {
	none: 'bg-muted',
	pending: 'bg-danger',
	progress: 'bg-warning',
	complete: 'bg-success',
} as const;

const totalTasks = visibleSubjects?.reduce((acc, s) => acc + s.tasks.length, 0) ?? 0;
---

<AppLayout title="Inicio">
	<Header userEmail={user.email ?? ''} totalTasks={totalTasks} doneTasks={doneSet.size} isAdmin={isAdmin} />

	<main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
		<div class="mb-6 flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm">
			<span class="text-muted-foreground">
				Trayecto{' '}
				<strong class="font-medium text-foreground">{trayecto?.name ?? trayecto?.year}</strong>
				{trayecto?.name && <span class="tabular-nums"> {trayecto?.year}</span>}
			</span>
			<span class="text-muted-foreground">
				<strong class="font-medium tabular-nums text-foreground">{visibleSubjects?.length ?? 0}</strong>{' '}
				asignaturas
			</span>
			<span class="text-muted-foreground">
				<strong class="font-medium tabular-nums text-foreground">{totalTasks}</strong> tareas
			</span>
		</div>

		<div class="grid gap-3 sm:grid-cols-2">
			{
				visibleSubjects?.map((subject) => {
					const total = subject.tasks.length;
					const done = subject.tasks.filter((t) => doneSet.has(t.id)).length;

					return (
						<button
							data-subject={subject.id}
							class="open-modal group flex flex-col gap-4 rounded-lg border bg-card p-4 text-left transition-colors hover:border-ring/40 hover:bg-muted/30"
						>
							<div class="flex items-start justify-between gap-2">
								<h2 class="font-medium tracking-tight">{subject.name}</h2>
								<span
									class="text-muted-foreground transition-transform group-hover:translate-x-0.5"
									aria-hidden="true"
								>
									›
								</span>
							</div>

							<div class="flex items-center justify-between">
								<span
									class="card-count text-sm tabular-nums text-muted-foreground"
									data-subject={subject.id}
								>
									{done}/{total}
								</span>
								<div class="flex gap-1.5">
									{[1, 2, 3].map((t) => {
										const status = trimStatus(subject.tasks, t);
										return (
											<span
												class="trim-dot h-2.5 w-2.5 rounded-full"
												data-subject={subject.id}
												data-trim={t}
												class:list={[statusClass[status]]}
												title={`Trimestre ${t}`}
											/>
										);
									})}
								</div>
							</div>
						</button>
					);
				})
			}
		</div>
	</main>

	{
		visibleSubjects?.map((subject) => (
			<Modal id={`modal-${subject.id}`} title={subject.name}>
				<Fragment slot="header-extra">
					<div class="flex gap-1.5">
						{[1, 2, 3].map((t) => {
							const status = trimStatus(subject.tasks, t);
							return (
								<span
									class="trim-dot h-2.5 w-2.5 rounded-full"
									data-subject={subject.id}
									data-trim={t}
									class:list={[statusClass[status]]}
									title={`Trimestre ${t}`}
								/>
							);
						})}
					</div>
				</Fragment>

				{subject.tasks.length === 0 ? (
					<p class="py-6 text-center text-sm text-muted-foreground">Ninguna tarea aún</p>
				) : (
					[1, 2, 3].map((t) => {
						const tasks = subject.tasks.filter((task) => task.trimestre === t).reverse();
						if (tasks.length === 0) return null;

						return (
							<div class="mb-5 last:mb-0">
								<h4 class="mb-1.5 text-xs font-medium text-muted-foreground">Trimestre {t}</h4>
								<ul class="flex flex-col gap-0.5">
									{tasks.map((task) => {
										const done = doneSet.has(task.id);
										return (
											<li>
												<button
													type="button"
													class="task-check group flex w-full items-center gap-3 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-muted/50"
													data-task-id={task.id}
													data-subject={subject.id}
													data-trim={task.trimestre}
													aria-pressed={done}
												>
													<span
														class:list={[
															'task-dot flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 transition-colors',
															done
																? 'border-success bg-success'
																: 'border-input bg-background group-hover:border-ring',
														]}
													>
														<svg
															class:list={['transition-opacity', done ? 'opacity-100' : 'opacity-0']}
															viewBox="0 0 12 12"
															fill="none"
															stroke="white"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
														>
															<path d="M2 6.5 L5 9.5 L10 3" />
														</svg>
													</span>
													<span
														class:list={[
															'task-text text-sm transition-colors',
															done ? 'text-muted-foreground line-through' : 'text-foreground',
														]}
													>
														{task.text}
													</span>
												</button>
											</li>
										);
									})}
								</ul>
							</div>
						);
					})
				)}
			</Modal>
		))
	}

	<SubjectsModal subjects={subjects ?? []} hidden={hiddenSet} />
	<ScheduleModal subjects={subjects ?? []} done={doneSet} />
	{isAdmin && <AdminSubjectsModal subjects={adminSubjects ?? []} />}
	{isAdmin && <AdminManageModal subjects={adminSubjects ?? []} />}

	<script>
		const hdrProg = document.getElementById('hdr-prog');
		const hdrDone = document.getElementById('hdr-done');
		const hdrPending = document.getElementById('hdr-pending');

		// Estado global: taskId -> done
		const state = new Map<string, boolean>();
		document.querySelectorAll<HTMLButtonElement>('.task-check').forEach((btn) => {
			state.set(btn.dataset.taskId!, btn.getAttribute('aria-pressed') === 'true');
		});

		function recomputeAll() {
			// Header global
			let done = 0;
			for (const d of state.values()) if (d) done++;
			const total = state.size;
			const pct = total > 0 ? Math.round((done / total) * 100) : 0;
			if (hdrProg) hdrProg.style.width = `${pct}%`;
			if (hdrDone) hdrDone.textContent = String(done);
			if (hdrPending) hdrPending.textContent = String(total - done);

			// Cards por asignatura
			const bySubject = new Map<string, HTMLButtonElement[]>();
			document.querySelectorAll<HTMLButtonElement>('.task-check').forEach((btn) => {
				const subj = btn.dataset.subject!;
				if (!bySubject.has(subj)) bySubject.set(subj, []);
				bySubject.get(subj)!.push(btn);
			});

			for (const [subj, btns] of bySubject) {
				const totalS = btns.length;
				const doneS = btns.filter((b) => state.get(b.dataset.taskId!)).length;

				document.querySelectorAll(`[data-subject="${subj}"].card-count`).forEach((el) => {
					el.textContent = `${doneS}/${totalS}`;
				});

				[1, 2, 3].forEach((t) => {
					const inTrim = btns.filter((b) => Number(b.dataset.trim) === t);
					let dotCls = 'bg-muted';
					let cellCls = '';
					if (inTrim.length > 0) {
						const doneCount = inTrim.filter((b) => state.get(b.dataset.taskId!)).length;
						if (doneCount === 0) {
							dotCls = 'bg-danger';
							cellCls = 'bg-danger/15';
						} else if (doneCount === inTrim.length) {
							dotCls = 'bg-success';
							cellCls = 'bg-success/15';
						} else {
							dotCls = 'bg-warning';
							cellCls = 'bg-warning/15';
						}
					}
					document
						.querySelectorAll(`.trim-dot[data-subject="${subj}"][data-trim="${t}"]`)
						.forEach((dot) => {
							dot.className = `trim-dot h-2.5 w-2.5 rounded-full ${dotCls}`;
						});
					document
						.querySelectorAll(`.schedule-cell[data-subject="${subj}"][data-trim="${t}"]`)
						.forEach((cell) => {
							cell.className = `schedule-cell h-9 border-r border-border px-3 py-2 last:border-r-0 ${cellCls}`;
						});
				});
			}
		}

		function setDone(taskId: string, done: boolean) {
			state.set(taskId, done);
			document.querySelectorAll<HTMLButtonElement>(`[data-task-id="${taskId}"]`).forEach((btn) => {
				btn.setAttribute('aria-pressed', String(done));
				const dot = btn.querySelector('.task-dot');
				if (dot) {
					dot.classList.toggle('border-success', done);
					dot.classList.toggle('bg-success', done);
					dot.classList.toggle('border-input', !done);
					dot.classList.toggle('bg-background', !done);
					dot.classList.toggle('group-hover:border-ring', !done);
				}
				btn.querySelector('.task-dot svg')?.classList.toggle('opacity-100', done);
				btn.querySelector('.task-dot svg')?.classList.toggle('opacity-0', !done);
				const taskText = btn.querySelector('.task-text');
				if (taskText) {
					taskText.classList.toggle('line-through', done);
					taskText.classList.toggle('text-muted-foreground', done);
					taskText.classList.toggle('text-foreground', !done);
				}
			});
			recomputeAll();
		}

		async function toggleTask(btn: HTMLButtonElement) {
			const taskId = btn.dataset.taskId!;
			const nowDone = !state.get(taskId);
			setDone(taskId, nowDone);

			const buttons = document.querySelectorAll<HTMLButtonElement>(`[data-task-id="${taskId}"]`);
			buttons.forEach((b) => {
				b.setAttribute('aria-busy', 'true');
				b.classList.add('pointer-events-none', 'opacity-60');
			});

			try {
				const res = await fetch('/api/tasks/toggle', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ task_id: taskId, done: nowDone }),
				});
				if (!res.ok) setDone(taskId, !nowDone);
			} catch {
				setDone(taskId, !nowDone);
			} finally {
				buttons.forEach((b) => {
					b.removeAttribute('aria-busy');
					b.classList.remove('pointer-events-none', 'opacity-60');
				});
			}
		}

		document.querySelectorAll<HTMLButtonElement>('.open-modal').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.subject;
				const modal = document.getElementById(`modal-${id}`) as HTMLDialogElement;
				modal?.showModal();
			});
		});

		document.querySelectorAll<HTMLButtonElement>('.task-check').forEach((btn) => {
			btn.addEventListener('click', () => toggleTask(btn));
		});
	</script>
</AppLayout>
